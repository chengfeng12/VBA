#!/bin/sh
# 校验 commit message 是否符合 CONTRIBUTING.md 的 Conventional Commits 规范
# 启用：git config core.hooksPath .githooks
# 绕过（不推荐）：git commit --no-verify

msg_file="$1"
first_line=$(sed -n '1p' "$msg_file" | sed 's/[[:space:]]*$//')

# 空信息、纯注释、合并/回滚类提交放行
case "$first_line" in
  "") exit 0 ;;
  \#*) exit 0 ;;
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

err() {
  printf '\n' >&2
  printf '\033[31m✗ 提交信息不符合规范：%s\033[0m\n' "$1" >&2
  printf '  你写的是：%s\n' "$first_line" >&2
  printf '  正确格式：<type>(<scope>): <中文动词开头的描述>\n' >&2
  printf '  type 取值：feat | fix | docs | refactor | style | test | chore | revert\n' >&2
  printf '  示例：feat(2.2): 新增 For 循环示例，含 Step 负数用法\n' >&2
  printf '  规范见：CONTRIBUTING.md\n\n' >&2
  exit 1
}

# 1. 禁止占位/无信息量文案
if printf '%s\n' "$first_line" \
  | grep -Eq '无法生成提交信息|本次代码变更|按要求修改|^[A-Za-z]+(\([^)]*\))?: *(update|change|modify|fix code)$'; then
  err "不要使用占位文案或 update/change 这类无信息量描述"
fi

# 2. 首行格式
printf '%s\n' "$first_line" \
  | grep -Eq '^(feat|fix|docs|refactor|style|test|chore|revert)(\([^()]+\))?: .*[^[:space:]]' \
  || err "首行必须是 <type>(<scope>): <描述>"

# 3. 结尾不加句号
case "$first_line" in
  *。|*.|*！|*!|*，|*,) err "描述结尾不要加标点（句号/感叹号/逗号）" ;;
esac

# 4. 描述长度（去掉 <type>(<scope>): 前缀后按字符数计）
subject=${first_line#*: }
len=$(printf '%s' "$subject" | LC_ALL=en_US.UTF-8 wc -m 2>/dev/null | tr -d ' ')
if [ -n "$len" ] && [ "$len" -gt 50 ] 2>/dev/null; then
  err "描述长度 ${len} 字，超过 50 字，请精简"
fi

exit 0
