Option Explicit

' ============================================================
' 5.5 随机数与模拟数据：没上机时先把判限逻辑跑通
'     Rnd / Randomize / 整数区间 / 固定种子复现
' ------------------------------------------------------------
' 和 JS 对照：
'     Math.random()                  →  Rnd            返回 [0, 1)，取不到 1
'     不播种每次都是新序列              →  VBA 不播种就"永远是同一条序列" ← 最大的差别
'     Math.floor(Math.random() * n)  →  Int(n * Rnd)
'     想固定种子复现                   →  先 Rnd(-1)，之后别再调 Randomize
' ------------------------------------------------------------
' ★ 定位：随机数只用来"造测试数据 / 压测 / 演示"，正式量产结果绝不能用随机数，
'   否则同一个料每次跑出来的判定都不一样，无法追溯
' ============================================================
Sub DemoRndBasics()
    ' ---- 不调 Randomize：每次运行的第一批数完全相同 ----
    ' Excel 只要没重启，序列就接着上一次往下走； 0.533424
    ' 重启 Excel 后，又回到同一条序列的起点
    ' JS 的 Math.random() 不会这样，所以这一点必须专门记一下
    MsgBox "第 1 个数：" & Rnd
    MsgBox "第 2 个数：" & Rnd

    ' ---- Randomize：用系统计时器播种 ----
    Randomize
    MsgBox "播种后：" & Rnd ' 0.314916
    ' ★ 一个程序只调一次，别放进循环：
    '   种子来自计时器，粒度有限，连着调很可能拿到同一个种子，
    '   结果就是一整列一模一样的"随机数"

    ' ---- 返回值范围：0 <= Rnd < 1 ----
    ' [0, 100) 的浮点：100 * Rnd
    ' [1, 100] 的整数：Int(100 * Rnd) + 1

    ' ---- 例：10 ~ 100 的随机整数（两端都取得到）----
    Dim n As Long, i As Long, s As String
    For i = 1 To 5
        n = RandInt(10, 100)                  ' 函数见本模块下方
        s = s & n & "  "
    Next
    MsgBox "10 ~ 100 的随机整数：" & s
    ' 手写版等价于：Int((100 - 10 + 1) * Rnd + 10)
    '   (100-10+1) = 91 个整数 → 91 * Rnd 得 [0, 91) 的浮点
    '   → Int 之后是 0~90 → 再加 10 → 10~100
    ' ★ 别写成 Int(90 * Rnd) + 10：那样最大只到 99，100 永远取不到
    ' ★ 前面的 Randomize 已经播种，这里不要再调，否则可能重复同一批数
End Sub


' ============================================================
' 生成 [lo, hi] 闭区间内的随机整数（含两端）
'   公式别记错：Int((hi - lo + 1) * Rnd + lo)
'   少写 +1 就永远取不到 hi
' ============================================================
Function RandInt(ByVal lo As Long, ByVal hi As Long) As Long
    RandInt = Int((hi - lo + 1) * Rnd + lo)
End Function


' ============================================================
' 生成"标称值 ± 容差"的模拟电压，用来喂判限函数
'   tol = 0.2 表示在 3.3 ± 0.2 V 之间取值
' ============================================================
Function RandVolt(ByVal nominal As Double, ByVal tol As Double) As Double
    RandVolt = nominal + (Rnd - 0.5) * 2 * tol      ' Rnd-0.5 → [-0.5, 0.5)
End Function


' ============================================================
' 用随机数造一批"像模像样"的测试数据，验证判限 / 良率统计
' ============================================================
Sub DemoMockData()
    Randomize

    Dim i As Long, v As Double, passCnt As Long
    For i = 1 To 100
        v = RandVolt(3.3, 0.35)                     ' 3.3 ± 0.35
        If v >= 3.3 And v <= 3.6 Then passCnt = passCnt + 1
        ' ★ 演示用；真实判限要带容差，见 1.7：v >= 3.3 - 1E-9
    Next
    MsgBox "100 颗里 Pass " & passCnt & " 颗，良率 " & Format$(passCnt / 100, "0.0%")

    Debug.Print "随机引脚：" & Array("VCC", "GND", "CLK")(RandInt(0, 2))
    ' ★ RandInt(0, 2) 才是三个元素；写 RandInt(0, 3) 会越界报"下标越界"
End Sub


' ============================================================
' 固定种子：让"随机"数据可复现，方便回归对比
'   批量脚本改错判限逻辑时，用同一批数据跑两次才能看出差异
' ============================================================
Sub DemoFixedSeed()
    Dim i As Long, s As String, seed As Single

    seed = Rnd(-1)                    ' ★ 负数参数 = 用这个数当种子，并返回第一个随机数
    For i = 1 To 5
        s = s & Format$(Rnd, "0.0000") & "  "
    Next
    MsgBox "固定种子序列：" & s
    ' 再跑一次，这 5 个数完全一样 → 可用来做回归

    ' ★ 中途别调 Randomize，也别让别的模块插进来调 Rnd，
    '   Rnd 的序列是整个 Excel 会话共享的，被别人动一下就复现不了
End Sub


' ============================================================
' Rnd 的几个反直觉行为
' ============================================================
Sub DemoRndTraps()
    ' ---- 1) Rnd(0) 不会前进，返回"上一次的结果" ----
    Dim a As Single
    a = Rnd
    MsgBox "Rnd(0) 和上一次相同吗？" & (Rnd(0) = a)      ' True
    ' 拿它重复取值会得到一列相同的数，看着像"卡住了"

    ' ---- 2) Rnd(负数) 会重置序列 ----
    ' 用了固定种子后，序列从种子的固定位置重新开始；
    ' 想在同一个过程里跑两批相同数据，记得再 Rnd(-1) 一次

    ' ---- 3) 质量不高，别用于统计严谨/安全场景 ----
    ' Rnd 是老的线性同余算法，周期短、低位相关性明显；
    ' 抽样、随机抽检这类"够用就行"的场景没问题，
    ' 需要严格均匀或不可预测就别用它（VBA 里也没有更好的内置方案）

    ' ---- 4) Excel 自带的 WorksheetFunction.RandBetween ----
    ' MsgBox Application.WorksheetFunction.RandBetween(1, 100)
    ' 好处是和 Excel 的随机函数一致（重算会变），
    ' 坏处是依赖 Excel 环境、不能脱离表格用 —— 纯 VBA 用 Rnd 更省心
End Sub
